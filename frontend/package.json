{
  "name": "dristhi-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "build": "next build",
    "start": "npx serve out -l 9002",
    "lint": "next lint",
    "deploy": "npm run build && firebase deploy --only hosting,functions,firestore",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "db:seed": "node src/scripts/seed-all.js",
    "db:seed:medical": "node src/scripts/seed-medical-staff.js",
    "db:seed:ambulances": "node src/scripts/seed-ambulances.js",
    "create-admin": "node src/scripts/create-admin.js",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-dristhi",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-google-maps/api": "^2.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.10.0",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.0.7",
    "next": "^15.3.6",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "firebase-tools": "^15.18.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
