# ── Firebase (Console → Project settings → Your apps → Web app) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Crowd-monitoring backend (FastAPI) ──
# Local dev: http://127.0.0.1:5000
# Firebase Hosting: leave EMPTY so the browser calls same-origin /api/** (proxied by the Cloud Function)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000

# ── Google Maps (Map View page) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Gemini (chatbot, autonomous agent, AI summary) ──
# Optional: falls back to NEXT_PUBLIC_FIREBASE_API_KEY. Without any key the app uses offline fallbacks.
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# ── Attendee app (task 07a) ──
# Event slug for the "Try the attendee app" demo link (/join?e=<slug>). Not a secret.
NEXT_PUBLIC_EVENT_SLUG=demo
# 1 = if the join API isn't deployed yet, give this browser a local "Attendee N" instead of failing.
# Set to 0 once POST /api/events/{slug}/join is live.
NEXT_PUBLIC_ATTENDEE_LOCAL_JOIN=1
