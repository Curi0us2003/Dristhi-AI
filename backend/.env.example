# Copy to backend/.env (git-ignored) and fill in. Never commit the real file.

# Cloud SQL through the Cloud SQL Auth Proxy on this laptop:
#   cloud-sql-proxy dhristi-ai-buildathon:asia-south1:dristhi-fdc --port 5433
# Local Docker instead (docker compose up -d db): postgresql+psycopg://dristhi:dristhi@127.0.0.1:5432/dristhi
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
DATABASE_URL=postgresql+psycopg://dristhi_app:<password>@127.0.0.1:5433/dristhi

# Throwaway database for pytest; every table in it is dropped and recreated.
TEST_DATABASE_URL=postgresql+psycopg://dristhi_app:<password>@127.0.0.1:5433/dristhi_test

# Attendee app base URL, used for the event QR link /join?e=<slug>.
# Deployed: the attendee Hosting site, e.g. https://dhristi-ai-attendee.web.app (not the admin site).
PUBLIC_APP_URL=http://localhost:9002

# Firebase project whose sign-in tokens the backend accepts (admins themselves are in Cloud SQL).
# Deployed: dhristi-ai-buildathon. Local with the Auth emulator: demo-dristhi, plus the host below.
FIREBASE_PROJECT_ID=demo-dristhi
# Only for local dev with `npm run emulators` in frontend/. Remove it to use real Firebase Auth.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
